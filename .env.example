# Bask's local time zone, used by Python and notification timestamps.
TZ=America/New_York

# Host port for the dashboard.
BASK_PORT=8080
# Bind directly to the trusted LAN by default. Use 127.0.0.1 when an HTTPS
# reverse proxy on this machine is the only intended entry point.
BASK_BIND_ADDRESS=0.0.0.0

# Optional: when an authenticating reverse proxy is the only way into Bask,
# name the one client-address header that proxy overwrites. Leave blank for a
# direct LAN install; arbitrary forwarding headers are ignored by default.
# Allowed: cf-connecting-ip, x-real-ip, x-forwarded-for
BASK_TRUSTED_PROXY_IP_HEADER=

# Persistent settings and SQLite history directory.
BASK_DATA_PATH=./data

# Private filesystem backups made before every update and by backup.sh.
BASK_BACKUP_PATH=./backups

# Keep storage beneath the dedicated Bask checkout by default. Set this to
# true only after creating and reviewing dedicated external data/backup mounts;
# the installer will inspect them but will never recursively change ownership.
BASK_ALLOW_EXTERNAL_PATHS=false

# Numeric owner for files in the bind mount. The installer writes the actual
# invoking user's values here; these defaults suit most Raspberry Pi installs.
BASK_UID=1000
BASK_GID=1000

# Optional resource ceilings. Docker may report that memory limits are not
# enforceable on older kernels; the PID/read-only/capability boundaries remain.
BASK_WEB_MEMORY_LIMIT=512m
BASK_SCANNER_MEMORY_LIMIT=256m

# Optional Shed integration for the read-only animal-room display.
# Use a private Docker/LAN URL and the same random token configured as
# SHED_DISPLAY_TOKEN in Shed. The token is used by Bask's server only and is
# never sent to the dashboard browser.
SHED_DISPLAY_URL=
SHED_DISPLAY_TOKEN=
